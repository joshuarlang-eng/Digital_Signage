[Unit]
Description=Swim Records Board - Telegram Ticker Bot Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Digital-Signage
Environment="PATH=/home/pi/Digital-Signage/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 /home/pi/Digital-Signage/ticker_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
